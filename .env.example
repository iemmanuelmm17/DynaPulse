###############################################################################
# DynaPulse environment
#
# Copy this file to the .env of your PRIVATE folder, e.g.
#   D:\private\dynapulse\.env
# Never commit the real .env - it holds API keys and the SMTP password.
#
# Only these are required to start:  APP_KEY, APP_URL, NS_* , MAIL_*
###############################################################################

# --- Application ------------------------------------------------------------
APP_NAME="DynaPulse"
APP_ENV=production
APP_DEBUG=false

# Public address of the portal, no trailing slash. Used in alert emails and
# signed links, so it must be reachable from the recipients' machines.
# Sub-folder deployment:  http://192.168.1.10/dynapulse/public
# Site-root deployment:   https://dynapulse.example.com
APP_URL=http://112.198.136.174/dynapulse/public

# Fallback timezone for domains that have none.
APP_TIMEZONE=America/New_York

# REQUIRED. 32+ random chars, encrypts the signed "Listen" links.
# Leave empty here and generate it with:
#   php bin\console.php key:generate
APP_KEY=

# --- Paths ------------------------------------------------------------------
# Leave both empty for the standard layout:
#   public  -> <htdocs>\dynapulse\public      (or any IIS site root)
#   private -> D:\private\dynapulse           (outside the web root)
# Only set these when the private folder cannot be found automatically.
PRIVATE_PATH=

# Absolute path to the public document root, if PHP's DOCUMENT_ROOT lies
# (reverse proxies).
PUBLIC_PATH=

# --- Database (SQLite) ------------------------------------------------------
# Defaults to <private>\storage\db\dynapulse.sqlite. Keep it outside the webroot.
DB_DATABASE=

# --- NetSapiens API ---------------------------------------------------------
NS_BASE_URL=https://ns-api.com

# Machine key used for CDRs, recordings and transcriptions.
NS_API_KEY=

# OAuth client used to validate manager logins on the sign-in page.
NS_CLIENT_ID=
NS_CLIENT_SECRET=

NS_TIMEOUT=30
# Set false only for a lab server with a self-signed certificate.
NS_VERIFY_SSL=true

# --- Ingestion --------------------------------------------------------------
# Long random secret that is part of the webhook URL. Generate one with:
#   php -r "echo bin2hex(random_bytes(24));"
WEBHOOK_SECRET=

# Filled in automatically by:  php bin\console.php subscription:create
WEBHOOK_SUBSCRIPTION_ID=

# Process a call right after the webhook post.
PROCESS_INLINE=true
POLL_ENABLED=true

# Overlap window (minutes) so no CDR is missed between polls.
POLL_LOOKBACK_MINUTES=10

# --- Office 365 / Outlook SMTP ----------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587

# starttls | ssl | none
MAIL_ENCRYPTION=starttls

MAIL_USERNAME=alerts@yourdomain.com

# App password - SMTP AUTH must be enabled on the mailbox.
MAIL_PASSWORD=

MAIL_FROM_ADDRESS=alerts@yourdomain.com
MAIL_FROM_NAME="DynaPulse Alerts"
MAIL_REPLY_TO=
MAIL_TIMEOUT=25

# --- Security / limits ------------------------------------------------------
SESSION_NAME=dynapulse

# Minutes of inactivity before the session expires.
SESSION_LIFETIME=480

# Comma separated IPs, for correct client IPs behind a proxy.
TRUSTED_PROXIES=

# Signed (30 day) audio links inside alert emails.
ALLOW_PUBLIC_AUDIO_LINKS=true

# Cache WAV/MP3 files under <private>\storage\recordings.
RECORDING_CACHE=false

# debug | info | warning | error
LOG_LEVEL=info
