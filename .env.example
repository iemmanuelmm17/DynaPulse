###############################################################################
# DynaPulse environment
# Copy this file to:  D:\private\DynaPulse\.env
# Never commit the real .env, it holds API keys and the SMTP password.
###############################################################################

# --- Application ------------------------------------------------------------
APP_NAME="DynaPulse"
APP_ENV=production                     # production | local
APP_DEBUG=false                        # true prints stack traces (local only)
APP_URL=https://dynapulse.example.com  # public root, no trailing slash. Used in emails.
APP_TIMEZONE=America/New_York           # fallback timezone for domains without one
APP_KEY=                               # REQUIRED: 32+ random chars, encrypts signed links.
                                       # generate: php private/bin/console.php key:generate

# --- Paths ------------------------------------------------------------------
# Leave empty when using the standard layout:
#   public  -> D:\www\DynaPulse\public
#   private -> D:\private\DynaPulse
# Set an absolute path only if you moved the private folder somewhere else.
PRIVATE_PATH=
# Absolute path to the public document root, only if PHP's DOCUMENT_ROOT is unreliable.
PUBLIC_PATH=

# --- Database (SQLite) ------------------------------------------------------
# Defaults to <private>/storage/db/dynapulse.sqlite. Keep it outside the webroot.
DB_DATABASE=

# --- NetSapiens API ---------------------------------------------------------
NS_BASE_URL=https://ns-api.com          # host or https://host/ns-api/v2
NS_API_KEY=                             # machine key used for recordings/CDR/transcriptions
NS_CLIENT_ID=                           # OAuth client id, used to validate manager logins
NS_CLIENT_SECRET=                       # OAuth client secret
NS_TIMEOUT=30
NS_VERIFY_SSL=true                      # set false only for self-signed lab servers

# --- Ingestion --------------------------------------------------------------
# Webhook (event subscription "cdr") + polling fallback.
WEBHOOK_SECRET=                         # long random string, part of the webhook URL.
                                       # generate: php -r "echo bin2hex(random_bytes(24));"

WEBHOOK_SUBSCRIPTION_ID=                # filled in automatically by subscription:create
PROCESS_INLINE=true                     # process the call right after the webhook post
POLL_ENABLED=true
POLL_LOOKBACK_MINUTES=10                # overlap window so no CDR is missed

# --- Office 365 / Outlook SMTP ---------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_ENCRYPTION=starttls                 # starttls | ssl | none
MAIL_USERNAME=alerts@yourdomain.com
MAIL_PASSWORD=                           # app password (SMTP AUTH must be enabled)
MAIL_FROM_ADDRESS=alerts@yourdomain.com
MAIL_FROM_NAME="DynaPulse Alerts"
MAIL_REPLY_TO=
MAIL_TIMEOUT=25

# --- Security / limits ------------------------------------------------------
SESSION_NAME=dynapulse
SESSION_LIFETIME=480                    # minutes
TRUSTED_PROXIES=                        # comma separated IPs, for correct client IPs
ALLOW_PUBLIC_AUDIO_LINKS=true           # signed (30 day) audio links inside alert emails
RECORDING_CACHE=false                   # true caches WAV/MP3 under private/storage/recordings
LOG_LEVEL=info                          # debug | info | warning | error
